{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Debug" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Debug" }
    ]
  },
  "GovSetttings": {
    "BaseUrl": "https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj"
  },
  "ConnectionStrings": {
    "Postgresql": "Server=localhost;Port=5432;Database=opencnpj;User Id=postgres;Password=postgres;Pooling=true;MinPoolSize=1;MaxPoolSize=200;ConnectionLifeTime=15;",
    "MongoDB": "mongodb://localhost:27017"
  },
  "BatchSettings": {
    "Size": 1000
  },
  "DatabaseSettings": {
    "FormatMongoDB": false,
    "FormatPostgres": true
  },
  "TweakSettings": {
    "DownloadSettings": {
      "AmountAtTheSameTime": 5,
      "RetryFailureDownloadsAmount": 5,
      "ExponencialSecondsIntervalBetweenRetries": 2,
      "LogProgress": true,
      "MbAmountToLog": 10
    },
    "RawFilesProcessingSettings": {
      "FilesAtTheSameTimeAmount": 10,
      "RecordsBatchAmount": 1000
    },
    "FormatRawDataSettings": {
      "RecordsBatchAmount": 1000,
      "AmountAtTheSameTime": 80
    }
  }
}