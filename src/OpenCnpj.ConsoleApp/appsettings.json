{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Debug" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Debug" }
    ]
  },
  "GovSetttings": {
    "BaseUrl": "https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj",
    "Keywords": [
      "Cnaes",
      "Empresas",
      "Estabelecimentos",
      "Motivos",
      "Municipios",
      "Naturezes",
      "Paises",
      "Qualificacoes",
      "Simples",
      "Socios"
    ]
  },
  "ConnectionStrings": {
    "Postgresql": "Server=localhost;Port=5432;Database=opencnpj;User Id=postgres;Password=postgres;Pooling=true;MinPoolSize=1;MaxPoolSize=200;ConnectionLifeTime=15;",
    "MongoDB": "mongodb://localhost:27017"
  },
  "BatchSettings": {
    "Size": 1000
  },
  "DatabaseSettings": {
    "FormatMongoDB": true,
    "FormatPostgres": true
  }
}